POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot
POSTGRES_DB=devpilot
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@db:5432/devpilot
LANGGRAPH_DATABASE_URI=postgresql://devpilot:devpilot@db:5432/devpilot
JWT_SECRET=请替换为足够长的随机开发密钥
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_MODE=mock
# mock 只展示检索摘录，不调用大模型；live 才根据资料生成回答。
# 使用真实模式时填写支持工具调用的 OpenAI 兼容 Chat Completions 接口。
MODEL_NAME=
LLM_API_KEY=
LLM_BASE_URL=
# 余弦相似度筛选阈值，不代表答案正确率；应结合评估集调整。
RAG_MIN_SCORE=0.5
# 本地开发默认保存到 service/data；Compose 固定使用 /app/data 的持久卷。
KNOWLEDGE_DATA_DIR=data
# 若 API 容器无法下载 Hugging Face 模型，可设置运行时代理（替换成实际可达地址）。
# HTTPS_PROXY=http://Windows主机IP:7897
# HTTP_PROXY=http://Windows主机IP:7897
# NO_PROXY=localhost,127.0.0.1,api,db,web
FRONTEND_ORIGINS=http://localhost:5173

# WSL 中拥有 /var/run/docker.sock 的组 ID（使用 `stat -c '%g' /var/run/docker.sock` 查询）。
DOCKER_GID=999
